    "eraseDataBody" : {
      "comment" : "Kvil user interface: eraseDataBody",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your local schedule, reflections, and Kvil weight entries will be permanently removed. Reminders and device snapshots will be cleared. Entries already saved to Apple Health and exported backups remain. Your purchase stays available to restore."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale planen, refleksjonene og vektoppføringene i Kvil slettes permanent. Påminnelser og enhetskopier tømmes. Oppføringer som er lagret i Apple Helse og eksporterte sikkerhetskopier beholdes. Kjøpet kan fortsatt gjenopprettes."
          }
        }
      }
    },
    "eula" : {
      "comment" : "Kvil user interface: eula",
