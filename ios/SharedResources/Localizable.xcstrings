    "watchHelp" : {
      "comment" : "Kvil user interface: watchHelp",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Kvil through the Watch app on iPhone, then open both apps once. Your Watch keeps the latest schedule so its timer works without your phone. Later changes arrive when the devices reconnect. Add Kvil to your watch face or Smart Stack."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Kvil via Watch-appen på iPhone, og åpne begge appene én gang. Klokken beholder den nyeste planen, slik at tidtakeren virker uten telefonen. Senere endringer kommer når enhetene kobles til igjen. Legg Kvil til på urskiven eller i Smart stabel."
          }
        }
      }
    },
