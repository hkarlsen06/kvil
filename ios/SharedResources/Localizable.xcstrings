    "onboardingWindowsTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pause between meals."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause mellom måltidene."
          }
        }
      },
      "comment" : "Short educational onboarding headline introducing daily fasting."
    },
    "onboardingWindowsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasting is time without food. Between meals, your body also draws on stored energy."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faste er tid uten mat. Mellom måltidene bruker kroppen også lagret energi."
          }
        }
      },
      "comment" : "Brief explanation of fasting; does not promise health benefits or a metabolic threshold."
    },
