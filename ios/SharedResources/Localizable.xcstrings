    "reminderCloseBody" : {
      "comment" : "Notification body at the scheduled closing. Calmly marks the planned pause and allows flexibility; do not imply the person has stopped eating.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your planned pause starts now. Adjust your schedule if you need to."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den planlagte pausen starter nå. Juster planen hvis du trenger det."
          }
        }
      }
    },
    "reminderCloseTitle" : {
      "comment" : "Notification title at the scheduled closing. Describes the end of the planned eating window, not the person’s behavior.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your eating window has ended"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spisevinduet er over"
          }
        }
      }
    },
    "reminderFailure" : {
      "comment" : "Kvil user interface: reminderFailure",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your schedule is saved, but reminders couldn’t be updated. Open Settings and try again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen er lagret, men påminnelsene kunne ikke oppdateres. Åpne Innstillinger og prøv igjen."
          }
        }
      }
    },
    "reminderHorizonHelp" : {
      "comment" : "Kvil user interface: reminderHorizonHelp",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders are scheduled about four weeks ahead and renewed when Kvil runs. Open Kvil occasionally to keep them going. Focus and system settings control delivery."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser planlegges omtrent fire uker frem og fornyes når Kvil kjører. Åpne Kvil av og til for å holde dem i gang. Fokus og systeminnstillinger styrer leveringen."
          }
        }
      }
    },
    "reminderOpenBody" : {
      "comment" : "Notification body at the scheduled opening. A relaxed invitation to eat, with no pressure to start immediately.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
