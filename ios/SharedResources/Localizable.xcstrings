          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen er lagret, men påminnelsene kunne ikke oppdateres. Åpne Innstillinger og prøv igjen."
          }
        }
      }
    },
    "reminderHorizonHelp" : {
      "comment" : "Kvil user interface: reminderHorizonHelp",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminders are scheduled about four weeks ahead and renewed when Kvil runs. Open Kvil occasionally to keep them going. Focus and system settings control delivery."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser planlegges omtrent fire uker frem og fornyes når Kvil kjører. Åpne Kvil av og til for å holde dem i gang. Fokus og systeminnstillinger styrer leveringen."
          }
        }
      }
    },
    "reminderOpenBody" : {
