    "cloudScheduleHelp" : {
      "comment" : "Settings footer accurately describes the CloudKit schedule payload and data excluded from it. Does not claim an App Review exemption or unconditional end-to-end encryption.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your schedule, including changes to today’s window and days off, syncs through encrypted iCloud fields. Reflections, weight and Apple Health data stay out of this sync."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen din, inkludert endringer i dagens spisevindu og fridager, synkroniseres via krypterte iCloud-felt. Refleksjoner, vekt og Apple Helse-data er ikke med i denne synkroniseringen."
          }
        }
      }
    },
    "cloudUnavailable" : {
      "comment" : "Kvil interface: cloudUnavailable",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is unavailable. Your schedule works on this device."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud er ikke tilgjengelig. Planen fungerer på denne enheten."
