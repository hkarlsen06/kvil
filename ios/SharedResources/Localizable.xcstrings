{
  "sourceLanguage" : "en",
  "strings" : {
    "aboutBody" : {
      "comment" : "Kvil user interface: aboutBody",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiet companion for a daily eating rhythm. Planned windows, gentle reminders, and a small space to reflect. Built to leave room for life."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rolig følgesvenn for en daglig spiserytme. Planlagte spisevinduer, rolige påminnelser og litt rom for å kjenne etter. Laget for å gi plass til livet."
          }
        }
      }
    },
