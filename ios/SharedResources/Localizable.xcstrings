    "cloudAccountChanged" : {
      "comment" : "Kvil interface: cloudAccountChanged",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iCloud account changed. Schedule sync is paused. Enable it again in Settings if you want to use this account."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kontoen er endret. Plansynkronisering er satt på pause. Slå den på igjen i Innstillinger hvis du vil bruke denne kontoen."
          }
        }
      }
    },
    "cloudConflict" : {
      "comment" : "Kvil interface: cloudConflict",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your local schedule is safe. iCloud changes could not be merged. Review your week and try syncing again."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale planen er lagret. iCloud-endringer kunne ikke slås sammen. Se gjennom uken og prøv å synkronisere igjen."
          }
        }
      }
    },
