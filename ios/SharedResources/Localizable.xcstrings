    "cloudScheduleHelp" : {
      "comment" : "Kvil interface: cloudScheduleHelp",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your planned times sync with iCloud. Reflections stay on this device; use a backup to recover them. Weight uses Apple Health when you choose to share it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare planlagte tider synkroniseres med iCloud. Refleksjoner blir på denne enheten. Bruk en sikkerhetskopi for å gjenopprette dem. Vekt bruker Apple Helse når du velger å dele den."
          }
        }
      }
    },
    "cloudUnavailable" : {
      "comment" : "Kvil interface: cloudUnavailable",
