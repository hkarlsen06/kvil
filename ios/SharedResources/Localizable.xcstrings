    "privacy" : {
      "comment" : "Kvil user interface: privacy",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personvern"
          }
        }
      }
    },
    "privacyControl" : {
      "comment" : "Kvil user interface: privacyControl",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can export, restore, or erase Kvil’s local data in Settings at any time, without a purchase. Exported files contain personal data; keep them somewhere you trust. Erasing Kvil does not erase Apple Health records or copies you exported."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan når som helst eksportere, gjenopprette eller slette lokale Kvil-data i Innstillinger, uten å kjøpe noe. Eksporterte filer inneholder personlige data. Oppbevar dem et sted du stoler på. Sletting i Kvil sletter ikke Apple Helse-oppføringer eller kopier du har eksportert."
          }
        }
      }
    },
    "privacyDevices" : {
      "comment" : "Kvil user interface: privacyDevices",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvil shares a copy of your schedule with its widgets and paired Apple Watch. These copies contain no weight or reflection history. Lock Screen widgets may show your planned eating times to anyone who can see your screen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvil deler en kopi av planen med widgetene og din sammenkoblede Apple Watch. Kopiene inneholder ingen vekt- eller refleksjonshistorikk. Widgeter på låseskjermen kan vise planlagte spisetider til andre som ser skjermen."
          }
        }
      }
    },
    "privacyHealth" : {
      "comment" : "Kvil user interface: privacyHealth",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health access is optional and limited to body weight. Kvil reads the entries you choose to share and saves new Kvil entries only with your permission. Health data is not used for advertising or analytics. Apple manages any synchronization you enable for Health."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til Apple Helse er valgfri og begrenset til kroppsvekt. Kvil leser oppføringene du velger å dele, og lagrer nye Kvil-oppføringer bare med tillatelse. Helsedata brukes ikke til reklame eller analyse. Apple administrerer synkronisering du slår på for Helse."
          }
        }
      }
    },
    "privacyLocal" : {
      "comment" : "Kvil interface: privacyLocal",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvil can sync your planned eating times through your own iCloud account. Reflections and weights entered in Kvil stay on your device and are not included in Kvil’s iCloud data. The local store is excluded from automatic device backups. Use Export a backup for recovery."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvil kan synkronisere planlagte spisetider via din egen iCloud-konto. Refleksjoner og vekter du legger inn i Kvil, blir på enheten og er ikke inkludert i Kvils iCloud-data. Det lokale lageret er utelatt fra automatiske enhetssikkerhetskopier. Bruk Eksporter en sikkerhetskopi for gjenoppretting."
          }
        }
      }
    },
    "privacyPolicy" : {
      "comment" : "Kvil user interface: privacyPolicy",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy policy"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personvernerklæring"
          }
        }
      }
    },
    "privacyPurchase" : {
      "comment" : "Kvil user interface: privacyPurchase",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple processes the optional one-time purchase. Kvil checks Apple’s signed purchase information to unlock full history. No Kvil account, advertising identifier, third-party analytics, or tracking SDK is used."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple behandler det valgfrie engangskjøpet. Kvil sjekker Apples signerte kjøpsinformasjon for å låse opp full historikk. Kvil bruker ingen egen konto, reklameidentifikator, tredjepartsanalyse eller sporingsverktøy."
          }
        }
      }
    },
    "privacyTitle" : {
      "comment" : "Kvil user interface: privacyTitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
