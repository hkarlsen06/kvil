    },
    "guideWindowTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the numbers mean"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva tallene betyr"
          }
        }
      },
      "comment" : "Guide section heading explaining fasting-hour and eating-hour ratios."
    },
    "guideWindowBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An eating window is the part of the day you set aside for meals. In a 14:10 rhythm, that window lasts ten hours, with fourteen hours between windows. Your schedule describes the plan. Your next-day check-in records what happened."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spisevindu er den delen av dagen du setter av til måltider. Med en 14:10-rytme varer vinduet i ti timer, med fjorten timer mellom vinduene. Spisevinduet viser hva du har planlagt. Oppsummeringen neste dag viser hvordan det gikk."
          }
        }
      },
      "comment" : "Explain time-restricted eating and the distinction between a plan and actual meals. Do not promise outcomes or claim a fast was completed."
    },
    "guideMealsTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Food and drink"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mat og drikke"
          }
        }
      },
      "comment" : "Guide section heading for practical eating-window information."
    },
    "guideMealsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count food and drinks with calories in your eating window. Water, unsweetened tea and black coffee can fit outside it. Keep eating balanced meals."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mat og drikke med kalorier inngå i spisevinduet. Vann, usøtet te og svart kaffe kan passe utenfor det. Fortsett å spise balanserte måltider."
          }
        }
      },
      "comment" : "General information paraphrased from the linked Johns Hopkins Medicine source, updated 7 April 2026. No dietary or weight-loss promises."
    },
    "guideFlexibleTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the plan fit your life"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La planen passe livet ditt"
          }
        }
      },
      "comment" : "Guide section heading encouraging flexible planning."
    },
    "guideFlexibleBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Plan to adjust a day or take time off. The next morning, you can note what happened and how you felt. If the window feels hard to live with, give your meals more room."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk Plan til å tilpasse en dag eller ta fri. Neste morgen kan du notere hvordan det gikk, og hvordan du hadde det. Hvis vinduet er vanskelig å leve med, gi måltidene mer plass."
          }
        }
      },
      "comment" : "Describe Kvil scheduling and next-day reflection, without streaks, scores, pressure, or automatically increasing fasting duration."
    },
    "guideSuitabilityTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before you start"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du begynner"
          }
        }
      },
      "comment" : "Guide section heading for medical suitability information."
    },
    "guideSuitabilityBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasting is not suitable for everyone. Avoid it if you are under 18, pregnant or breastfeeding, or have a history of eating disorders. If you have diabetes or take medication, discuss fasting with your clinician first. Seek medical advice if fasting makes you feel unwell."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faste passer ikke for alle. Unngå faste hvis du er under 18 år, er gravid eller ammer, eller har hatt en spiseforstyrrelse. Hvis du har diabetes eller bruker medisiner, snakk med legen din før du begynner. Søk medisinske råd hvis du føler deg dårlig av å faste."
          }
        }
      },
      "comment" : "Suitability cautions paraphrased from Johns Hopkins Medicine. Preserve age, pregnancy/breastfeeding, eating-disorder history, diabetes/medication consultation, and symptoms advice."
    },
    "guideSourceHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health information from Johns Hopkins Medicine, updated 7 April 2026."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helseinformasjon fra Johns Hopkins Medicine, oppdatert 7. april 2026."
          }
        }
      },
      "comment" : "Attribution for the health information in the guide. The date is the source article update date, not a claim that Kvil was medically reviewed."
    },
    "guideSourceTitle" : {
